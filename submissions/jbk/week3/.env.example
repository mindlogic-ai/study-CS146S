# TMDB API credentials
# 발급: https://www.themoviedb.org/settings/api
TMDB_ACCESS_TOKEN=your_tmdb_access_token_here
TMDB_API_KEY=your_tmdb_api_key_here

# MCP 서버 인증 (SSE 모드 전용)
# 클라이언트가 "Authorization: Bearer <이 값>" 헤더로 인증
MCP_API_KEY=your_mcp_server_api_key_here

# 외부 접속 URL (ngrok 등 프록시 사용 시 설정)
MCP_SERVER_URL=https://your-subdomain.ngrok-free.app
