# Investment Helper MCP Server Configuration

# =============================================================================
# HTTP/SSE Transport (for remote deployment)
# =============================================================================

# Required for HTTP mode - clients must provide this in Authorization header
# Generate a secure random key: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=your-secret-api-key-here

# Server configuration
HOST=0.0.0.0
PORT=8000

# =============================================================================
# General Settings
# =============================================================================

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# CoinGecko rate limit (calls per minute, free tier allows 10-30)
COINGECKO_RATE_LIMIT=10
